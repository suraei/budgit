      "signals": {
        "words": ["plusvalía", "plusvalia", "fifo", "irpf", "modelo 100", "modelo 130", "modelo 303", "modelo 721", "iva", "tva", "autónomo", "autonomo", "contabilidad", "asiento contable", "conciliación", "conciliacion", "balance sheet", "p&l", "tax", "impuesto", "accounting", "reconcil", "journal entry", "capital gain", "cost basis", "déclaration"],
