    "release": {
      "pick": ["engineering:deploy-checklist", "superpowers:verification-before-completion", "legal-eu-es-fr"],
      "also": [],
      "signals": {
        "words": ["release", "publicar", "publish", "rollback", "deploy", "desplegar", "hotfix", "changelog", "bump version"],
        "files": ["CHANGELOG*"]
      },
      "outside": [
        {"tool": "codex", "role": "second reviewer", "when": "the release gate, after the Claude reviewer"},
        {"tool": "gemini", "role": "fallback reviewer", "when": "the Codex reviewer is unavailable"}
      ]
    },
    "finance-accounting": {
      "pick": ["fiscal-es-fr", "finance:financial-statements"],
      "also": [
        {"skill": "finance:journal-entry", "when": "an accounting entry"},
        {"skill": "finance:journal-entry-prep", "when": "entries prepared for a close"},
