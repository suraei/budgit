    "office-docs": {
      "pick": ["anthropic-skills:docs"],
      "also": [
        {"skill": "anthropic-skills:docx", "when": "a Word file is named or edited"},
        {"skill": "anthropic-skills:xlsx", "when": "a spreadsheet file is the input or output"},
        {"skill": "anthropic-skills:pdf", "when": "a PDF is read, filled or made"},
        {"skill": "anthropic-skills:pptx", "when": "a slide deck file is the output"}
      ],
      "signals": {
        "words": ["docx", "xlsx", "pptx", "excel", "word document", "documento word", "pdf", "hoja de cálculo", "hoja de calculo", "spreadsheet", "powerpoint"],
        "files": ["*.docx", "*.xlsx", "*.xls", "*.pdf", "*.pptx"]
