  "profiles": {},
  "outside": {
    "tools": {
      "codex": "second reviewer for the release and security gates",
      "gemini": "fallback reviewer when Codex is unavailable, and image work",
      "openrouter": "overflow model when the Claude budget is tight"
    },
    "protected": {
      "clean_copy": "required",
      "rule": "a protected project goes to any outside tool only as a scanned clean copy, never as its own files"
    }
  },
  "unused": {
    "investing:*": "investing plugin skills: no type needs them yet",
    "cowork:*": "cowork plugin skills: desktop-app chores, not technician tasks",
    "psychologist-analyst": "analysis of people; no technician task type needs it"
  }
}
