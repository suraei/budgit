{
  "description": "Budgit: input ledger (bound sessions), commit-identity guard (all sessions), real-data guard + push reminder (bound sessions); Brote's event line for the floating window (visual only, writes one short line only while the app runs)",
  "modules": [
    "./register.jsx"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env -u PYTHONDONTWRITEBYTECODE python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" user-prompt-submit",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Library/Application Support/BroteWindow/events.log\"; [ -f \"$f\" ] || exit 0; s=/bin/dash; [ -x \"$s\" ] || s=sh; exec \"$s\" \"${CLAUDE_PLUGIN_ROOT}/hooks/brote-event.sh\" prompt",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "env -u PYTHONDONTWRITEBYTECODE python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/floatctl.py\" ensure --prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|Bash|SubagentHandback|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "env -u PYTHONDONTWRITEBYTECODE python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" post-tool-use",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Library/Application Support/BroteWindow/events.log\"; [ -f \"$f\" ] || exit 0; s=/bin/dash; [ -x \"$s\" ] || s=sh; exec \"$s\" \"${CLAUDE_PLUGIN_ROOT}/hooks/brote-event.sh\" post",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env -u PYTHONDONTWRITEBYTECODE python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" stop",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Library/Application Support/BroteWindow/events.log\"; [ -f \"$f\" ] || exit 0; s=/bin/dash; [ -x \"$s\" ] || s=sh; exec \"$s\" \"${CLAUDE_PLUGIN_ROOT}/hooks/brote-event.sh\" stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "env -u PYTHONDONTWRITEBYTECODE python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" session-start",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "env -u PYTHONDONTWRITEBYTECODE python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/floatctl.py\" ensure",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env -u PYTHONDONTWRITEBYTECODE python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" session-end",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "env -u PYTHONDONTWRITEBYTECODE python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/floatctl.py\" session-end",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env -u PYTHONDONTWRITEBYTECODE python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" post-compact",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Agent|Task|Read|Grep|Glob|WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "env -u PYTHONDONTWRITEBYTECODE python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" pre-tool-use",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Library/Application Support/BroteWindow/events.log\"; [ -f \"$f\" ] || exit 0; s=/bin/dash; [ -x \"$s\" ] || s=sh; exec \"$s\" \"${CLAUDE_PLUGIN_ROOT}/hooks/brote-event.sh\" pre",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env -u PYTHONDONTWRITEBYTECODE python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" subagent-stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env -u PYTHONDONTWRITEBYTECODE python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" post-tool-use-failure",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Library/Application Support/BroteWindow/events.log\"; [ -f \"$f\" ] || exit 0; s=/bin/dash; [ -x \"$s\" ] || s=sh; exec \"$s\" \"${CLAUDE_PLUGIN_ROOT}/hooks/brote-event.sh\" fail",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Library/Application Support/BroteWindow/events.log\"; [ -f \"$f\" ] || exit 0; s=/bin/dash; [ -x \"$s\" ] || s=sh; exec \"$s\" \"${CLAUDE_PLUGIN_ROOT}/hooks/brote-event.sh\" apifail",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Library/Application Support/BroteWindow/events.log\"; [ -f \"$f\" ] || exit 0; s=/bin/dash; [ -x \"$s\" ] || s=sh; exec \"$s\" \"${CLAUDE_PLUGIN_ROOT}/hooks/brote-event.sh\" perm",
            "timeout": 5
          }
        ],
        "matcher": "permission_prompt"
      }
    ]
  }
}
