  "progress_bar": {
    "w": 62,
    "h": 5,
    "note": "outline o on rows 0 and 4 and columns 0 and 61; fill l (rows 1-2) and L (row 3) up to round(60 * done / total); empty P; 3 pt per art px"
  }
